{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SurveyorLedger;Integrated Security=true;"
  },
  "JwtSettings": {
    "Key": "your-super-secret-key-at-least-32-characters-long-for-HS256-algorithm-please",
    "Issuer": "https://surveyorledger.com",
    "Audience": "surveyorledger-api",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "AzureCommunicationServices": {
    "ConnectionString": "endpoint=https://<resource-name>.communication.azure.com/;accesskey=<access-key>",
    "SenderEmail": "noreply@<mail-domain>.azurecomm.net"
  },
  "OTP": {
    "ExpirationMinutes": 3,
    "MaxAttempts": 3,
    "ResendCooldownSeconds": 60
  },
  "AppSettings": {
    "UiBaseUrl": "http://localhost:4200"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
